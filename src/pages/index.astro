---
import { getCollection } from 'astro:content';

import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import PostList from '../components/PostList.astro';
import SectionTitle from '../components/SectionTitle.astro';

import '../styles/global.css';
import '../styles/home.css';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latestPost = posts[0];
const otherPosts = posts.slice(1);

const BASE_URL = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title="RuuDevNote"
			description="개발하면서 배우고, 만들고, 기록하는 블로그"
		/>
	</head>

	<body>
		<Header />

		<main class="home">
			<section class="hero">
				<p class="hero-eyebrow">DEVELOPER BLOG</p>

				<h1>
					ルルぴ<br />
					<span>DevNote</span>
				</h1>

				<p class="hero-description">
					유니티 개발자가 될테야<br />
					개발자가 될 수 있을까?
				</p>

				<a class="hero-button" href={`${BASE_URL}blog/`}>
					블로그 둘러보기 →
				</a>
			</section>

			{latestPost && (
				<section class="latest">
					<SectionTitle
						title="Latest post"
						description="가장 최근에 작성한 글부터 확인해보세요."
					/>

					<PostCard post={latestPost} featured />
				</section>
			)}

			{otherPosts.length > 0 && (
				<section class="all-posts">
					<SectionTitle
						title="All posts"
						description="지금까지 작성한 모든 글을 모아봤습니다."
					/>

					<PostList posts={otherPosts} />
				</section>
			)}
		</main>

		<Footer />
	</body>
</html>