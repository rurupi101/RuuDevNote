---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: any;
	featured?: boolean;
}

const { post, featured = false } = Astro.props;

const BASE_URL = import.meta.env.BASE_URL;
const postUrl = `${BASE_URL}blog/${post.id}/`;
---

<article class:list={['post-card', { featured }]}>
	<a href={postUrl}>
		{post.data.heroImage && (
			<div class="post-image">
				<Image
					src={post.data.heroImage}
					alt={post.data.title}
					width={featured ? 960 : 600}
					height={featured ? 480 : 340}
				/>
			</div>
		)}

		<div class="post-content">
			<p class="post-date">
				<FormattedDate date={post.data.pubDate} />
			</p>

			<h2>{post.data.title}</h2>

			{post.data.description && (
				<p class="post-description">
					{post.data.description}
				</p>
			)}

			<span class="read-more">
				Read article →
			</span>
		</div>
	</a>
</article>

<style>
	.post-card {
		margin: 0;
	}

	.post-card > a {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.post-image {
		overflow: hidden;
		border-radius: 16px;
		background: var(--surface);
		border: 1px solid var(--border);
	}

	.post-image img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		transition: transform 0.35s ease;
	}

	.post-card:hover .post-image img {
		transform: scale(1.025);
	}

	.post-content {
		padding: 18px 2px 0;
	}

	.post-date {
		margin: 0 0 8px;
		color: var(--muted);
		font-size: 13px;
	}

	h2 {
		margin: 0;
		color: var(--text);
		font-size: 21px;
		line-height: 1.35;
		letter-spacing: -0.035em;
	}

	.post-description {
		margin: 10px 0 0;
		color: var(--muted);
		font-size: 14px;
		line-height: 1.65;
	}

	.read-more {
		display: inline-block;
		margin-top: 14px;
		color: var(--accent);
		font-size: 13px;
		font-weight: 700;
	}

	.featured .post-content {
		padding-top: 22px;
	}

	.featured h2 {
		font-size: clamp(28px, 4vw, 42px);
		line-height: 1.15;
	}

	.featured .post-description {
		max-width: 680px;
		font-size: 16px;
	}
</style>