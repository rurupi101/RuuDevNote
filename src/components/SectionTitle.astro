---
interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
---

<div class="section-title">
	<div>
		<p class="eyebrow">BLOG</p>
		<h2>{title}</h2>
	</div>

	{description && <p class="description">{description}</p>}
</div>

<style>
	.section-title {
		margin-bottom: 32px;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 30px;
	}

	.eyebrow {
		margin: 0 0 8px;
		color: var(--accent);
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.12em;
	}

	h2 {
		margin: 0;
		color: var(--text);
		font-size: 28px;
		line-height: 1.2;
		letter-spacing: -0.04em;
	}

	.description {
		max-width: 420px;
		margin: 0;
		color: var(--muted);
		font-size: 14px;
		line-height: 1.7;
	}

	@media (max-width: 720px) {
		.section-title {
			display: block;
		}

		.description {
			margin-top: 12px;
		}
	}
</style>